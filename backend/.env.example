PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Optional read-only integrations. Leave blank to keep labelled sample data.
# ClickUp: personal or team token with read access. This API only sends GET.
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# Google: OAuth access token with calendar.readonly and drive.readonly.
# This API only sends GET. Do not use a token that you cannot restrict to read scopes.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
