PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Optional read-only integrations. Leave blank to keep labelled sample data.
# ClickUp: personal or team token with read access. This API only sends GET.
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# Google access token. Calendar scheduling needs events, free/busy, and ACL.
# Drive metadata reads can use drive.readonly on the same token. Do not use a personal token.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
