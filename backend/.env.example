PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Optional read-only integrations. Leave blank to keep labelled sample data.
# ClickUp: personal or team token with read access. This API only sends GET.
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# Google access token from an Impact account. Do not use a personal token.
# Calendar: https://www.googleapis.com/auth/calendar
# Drive library and sharing: https://www.googleapis.com/auth/drive
# File contents are not downloaded. Owner is never granted from this desk.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Slack: bot token from api.slack.com → OAuth & Permissions. Invite the bot to the channel.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ChatGPT via the OpenAI API. Leave blank until an Impact key is issued.
# The desk sends only the note a staff member types. It does not attach budgets, documents, or tokens.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude via the Anthropic API. Leave blank until an Impact key is issued.
# The desk sends only the source a staff member pastes. It does not attach Drive files, budgets, or tokens.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Otter.ai Enterprise API key from Integrations → Developer. Read-only.
# Leave blank to keep labelled sample meeting notes.
OTTER_API_KEY=

# Set only when this process serves the built web app, as the Docker image does.
# WEB_ROOT=
